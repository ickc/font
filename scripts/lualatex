#!/bin/sh

# Quarto can prefer a separately installed TinyTeX over the host TeX Live.
# Select the conventional host executable so Quarto and vanilla Pandoc agree.
case "$(uname -s)" in
  Darwin)
    if [ -x /Library/TeX/texbin/lualatex ]; then
      engine=/Library/TeX/texbin/lualatex
    else
      engine=$(command -v lualatex)
    fi
    ;;
  Linux)
    if [ -x /usr/bin/lualatex ]; then
      engine=/usr/bin/lualatex
    else
      engine=$(command -v lualatex)
    fi
    ;;
  *)
    echo "Only macOS and Linux are supported" >&2
    exit 1
    ;;
esac

if [ -z "$engine" ]; then
  echo "lualatex was not found; install TeX Live first" >&2
  exit 1
fi

exec "$engine" "$@"
